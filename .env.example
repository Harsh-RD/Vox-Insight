# ==============================================================================
# VoxInsight Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# NEVER commit real production secrets, credentials, or API keys into git.

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=voxinsight
POSTGRES_PASSWORD=voxinsight_dev
POSTGRES_DB=voxinsight
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://voxinsight:voxinsight_dev@localhost:5432/voxinsight

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Generate a secure 64-character secret in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me-to-a-random-64-char-string-in-production-env
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security (set COOKIE_SECURE=true when serving over HTTPS in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Optional comma-separated list of additional allowed CORS origins (e.g. https://app.voxinsight.com)
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Ingestion & Upload Constraints
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# Semantic Retrieval & Vector Index (FAISS)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
# Directory where FAISS binary indexes and ID mappings are saved
# Default resolves to backend/data/faiss/
# FAISS_INDEX_DIR=data/faiss

# ------------------------------------------------------------------------------
# Grounded Business Assistant (RAG) & LLM Configuration
# ------------------------------------------------------------------------------
# Pluggable OpenAI-compatible LLM provider
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Set your API key below or via environment variable to enable live assistant responses
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30.0

# Retrieval & Context Grounding Limits
RAG_TOP_K=12
RAG_MAX_CONTEXT_ITEMS=8
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_HISTORY_MESSAGES=6
RAG_MIN_SIMILARITY=0.20
